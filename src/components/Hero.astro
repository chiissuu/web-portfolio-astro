---
const { t } = Astro.props;
---

<header id="inicio" class="header">
  <div class="hero-content">
    <p class="hero-tag">{t.hero.tag}</p>
    <h1>{t.hero.title}</h1>
    <h2>{t.hero.subtitle}</h2>
    <p>{t.hero.text}</p>

    <div class="hero-buttons">
      <a href="#proyectos" class="btn primary">{t.hero.primaryCta}</a>
      <a href="#contacto" class="btn secondary">{t.hero.secondaryCta}</a>
    </div>
  </div>

  <div class="hero-visual" aria-label={t.hero.imageAlt}>
    <div class="hero-portrait">
      <img src={`${import.meta.env.BASE_URL}/assets/images/pfp-provisional.png`} alt={t.hero.imageAlt}>
    </div>

    <div class="hero-visual-caption">
      {t.hero.caption.map((item) => <span>{item}</span>)}
    </div>
  </div>
</header>
