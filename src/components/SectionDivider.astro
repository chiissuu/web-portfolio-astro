---
const {
  variant = "tilt",
  tone = "light",
  flip = false,
} = Astro.props;

const paths = {
  tilt: "M1200 120L0 16.48 0 0 1200 0 1200 120z",
  triangle: "M1200 0L0 0 892.25 114.72 1200 0z",
  triangleNegative: "M892.25 114.72L0 0 0 120 1200 120 1200 0 892.25 114.72z",
  waves: "M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z",
};
---

<div class:list={["section-divider", `section-divider-${tone}`, flip && "section-divider-flip"]} aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
    <path d={paths[variant]} fill="currentColor"></path>
  </svg>
</div>
