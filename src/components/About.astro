---
const { t } = Astro.props;
const [firstLink, secondLink, thirdLink] = t.about.competitive.links;
---

<section id="sobre-mi" class="section section-light">
  <h2 class="section-title">{t.about.title}</h2>

  <div class="two-columns">
    {t.about.cards.map((card) => (
      <article class="text-card">
        <h3>{card.title}</h3>

        {card.paragraphs.map((paragraph) => <p>{paragraph}</p>)}

        {card.link && (
          <a class="text-link" href={card.link.href} target="_blank" rel="noopener noreferrer">
            {card.link.text}
          </a>
        )}
      </article>
    ))}

    <article class="text-card">
      <h3>{t.about.competitive.title}</h3>

      <p>
        {t.about.competitive.intro}{" "}
        <a class="text-link-inline" href={firstLink.href} target="_blank" rel="noopener noreferrer">{firstLink.text}</a>,{" "}
        <a class="text-link-inline" href={secondLink.href} target="_blank" rel="noopener noreferrer">{secondLink.text}</a>,{" "}
        <a class="text-link-inline" href={thirdLink.href} target="_blank" rel="noopener noreferrer">{thirdLink.text}</a>{" "}
        {t.about.competitive.outro}
      </p>

      {t.about.competitive.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </article>
  </div>
</section>
