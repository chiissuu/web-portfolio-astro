---
const { t } = Astro.props;
const [emailLabel, githubLabel, linktreeLabel, linkedinLabel] = t.contact.links;
---

<section id="contacto" class="section section-light contact-section">
  <h2 class="section-title">{t.contact.title}</h2>
  <p>{t.contact.text}</p>

  <div class="contact-links">
    <a href="mailto:jesusleonromero233@gmail.com">{emailLabel}</a>
    <a href="https://github.com/chiissuu" target="_blank" rel="noopener noreferrer">{githubLabel}</a>
    <a href="https://linktr.ee/chiissuu" target="_blank" rel="noopener noreferrer">{linktreeLabel}</a>
    <a href="#">{linkedinLabel}</a>
  </div>
</section>
