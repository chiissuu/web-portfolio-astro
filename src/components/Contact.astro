---
const { t } = Astro.props;
const [emailLabel, githubLabel, linkedinLabel, cvLabel] = t.contact.links;
const isSpanish = t.nav.contact === "Contacto";

const form = isSpanish
  ? {
      title: "Cuéntame qué necesitas",
      name: "Nombre",
      email: "Email",
      service: "Tipo de servicio",
      budget: "Presupuesto estimado",
      timeline: "Plazo",
      message: "Descripción del proyecto",
      submit: "Enviar solicitud",
      options: ["Web corporativa", "Landing page", "Proyecto de datos", "Diseño UI/visual", "Otro"],
      budgets: ["Por definir", "Menos de 500 EUR", "500 - 1.000 EUR", "1.000 - 3.000 EUR", "Más de 3.000 EUR"],
      timelines: ["Sin fecha cerrada", "1-2 semanas", "1 mes", "2-3 meses", "Más de 3 meses"],
      placeholder:
        "Describe el objetivo, páginas necesarias, referencias visuales, contenido disponible y cualquier requisito técnico.",
    }
  : {
      title: "Tell me what you need",
      name: "Name",
      email: "Email",
      service: "Service type",
      budget: "Estimated budget",
      timeline: "Timeline",
      message: "Project description",
      submit: "Send request",
      options: ["Corporate website", "Landing page", "Data project", "UI/visual design", "Other"],
      budgets: ["To be defined", "Under EUR 500", "EUR 500 - 1,000", "EUR 1,000 - 3,000", "Over EUR 3,000"],
      timelines: ["No fixed date", "1-2 weeks", "1 month", "2-3 months", "More than 3 months"],
      placeholder:
        "Describe the goal, required pages, visual references, available content, and any technical requirements.",
    };
---

<section id="contacto" class="section section-light contact-section">
  <div class="contact-card">
    <div>
      <h2 class="section-title">{t.contact.title}</h2>
      <p class="contact-cta">{t.contact.cta}</p>
      <p>{t.contact.text}</p>
    </div>

    <div class="contact-links">
      <a class="btn primary contact-primary" href="mailto:jesusleonromero233@gmail.com">{emailLabel}</a>
      <a href="https://github.com/chiissuu" target="_blank" rel="noopener noreferrer">{githubLabel}</a>
      <span class="contact-link-pending" aria-label={`${linkedinLabel}: enlace pendiente`}>{linkedinLabel}</span>
      <a href={`${import.meta.env.BASE_URL}/docs/cv.pdf`} target="_blank" rel="noopener noreferrer">{cvLabel}</a>
    </div>
  </div>

  <form class="contact-form" action="mailto:jesusleonromero233@gmail.com" method="post" enctype="text/plain">
    <h3>{form.title}</h3>

    <div class="contact-form-grid">
      <div class="form-field">
        <label for="contact-name">{form.name}</label>
        <input id="contact-name" name={form.name} type="text" autocomplete="name" required />
      </div>

      <div class="form-field">
        <label for="contact-email">{form.email}</label>
        <input id="contact-email" name={form.email} type="email" autocomplete="email" required />
      </div>

      <div class="form-field">
        <label for="contact-service">{form.service}</label>
        <select id="contact-service" name={form.service} required>
          <option value="" selected disabled>{form.service}</option>
          {form.options.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>

      <div class="form-field">
        <label for="contact-budget">{form.budget}</label>
        <select id="contact-budget" name={form.budget}>
          {form.budgets.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>

      <div class="form-field">
        <label for="contact-timeline">{form.timeline}</label>
        <select id="contact-timeline" name={form.timeline}>
          {form.timelines.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>

      <div class="form-field form-field-full">
        <label for="contact-message">{form.message}</label>
        <textarea id="contact-message" name={form.message} placeholder={form.placeholder} required></textarea>
      </div>
    </div>

    <div class="contact-form-actions">
      <button class="btn primary" type="submit">{form.submit}</button>
    </div>
  </form>
</section>
