---
const { t } = Astro.props;
---

<section id="proyectos" class="section section-dark">
  <h2 class="section-title centered">{t.projects.title}</h2>
  <p class="section-intro centered">{t.projects.intro}</p>

  <div class="projects-grid">
    {t.projects.items.map((project) => (
      <article class="project-card">
        <div class="project-visual" role="img" aria-label={project.alt}>
          <span>{project.category}</span>
          <strong>{project.visualTitle ?? project.title}</strong>
        </div>
        <div class="project-content">
          <p class="project-category">{project.category}</p>
          <h3>{project.title}</h3>
          <p>{project.description}</p>

          <div class="tags">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>

          <div class="project-links">
            {project.links.map((link) => (
              link.href
                ? <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
                : <span class="project-link-pending" aria-label={`${link.label}: enlace pendiente`}>{link.label} <small>próximamente</small></span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
