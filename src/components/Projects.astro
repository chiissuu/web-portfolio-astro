---
const { t } = Astro.props;
---

<section id="proyectos" class="section section-dark">
  <h2 class="section-title">{t.projects.title}</h2>
  <p class="section-intro">{t.projects.intro}</p>

  <div class="projects-grid">
    {t.projects.items.map((project) => (
      <article class="project-card">
        <img src={`${import.meta.env.BASE_URL}${project.image}`} alt={project.alt} />
        <div class="project-content">
          <h3>{project.title}</h3>
          <p>{project.description}</p>

          <div class="tags">
            {project.tags.map((tag) => <span>{tag}</span>)}
          </div>

          <div class="project-links">
            {project.links.map((link) => <a href="#">{link}</a>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
