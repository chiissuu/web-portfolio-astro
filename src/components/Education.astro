---
const { t } = Astro.props;
---

<section id="formacion" class="section section-dark">
  <h2 class="section-title">{t.education.title}</h2>

  <div class="education-layout">
    <article class="text-card education-main-card">
      <h3>{t.education.degree}</h3>

      {t.education.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </article>

    <article class="text-card education-languages-card">
      <h3>{t.education.languagesTitle}</h3>

      <ul class="language-list">
        {t.education.languages.map(([name, level]) => (
          <li>
            <span>{name}</span>
            <strong>{level}</strong>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
