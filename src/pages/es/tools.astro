---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import ToolPage from "../../components/ToolPage.astro";
import Footer from "../../components/Footer.astro";
import NavbarScrollController from "../../components/react/NavbarScrollController.jsx";
import { translations } from "../../i18n/translations.js";

const lang = "es";
const t = translations[lang];
---

<BaseLayout lang={lang} title={t.seo.tools.title} description={t.seo.tools.description} page="tools">
  <Navbar lang={lang} t={t} page="tools" />
  <NavbarScrollController client:load />
  <ToolPage t={t} />
  <Footer t={t} />
</BaseLayout>
